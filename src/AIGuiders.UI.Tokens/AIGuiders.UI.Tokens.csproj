<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AIGuiders.UI.Tokens</RootNamespace>
    <AssemblyName>AIGuiders.UI.Tokens</AssemblyName>
    <PackageId>AIGuiders.UI.Tokens</PackageId>
    <Description>Design tokens and base human-surface CSS variables for AIGuiders UI adapters.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot\**" Pack="true" PackagePath="content\wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="wwwroot\aiguiders-ui-tokens.css" LogicalName="AIGuiders.UI.Tokens.wwwroot.aiguiders-ui-tokens.css" />
  </ItemGroup>
</Project>
